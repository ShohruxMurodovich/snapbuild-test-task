{
  "name": "snapbuild-test-task",
  "version": "1.0.0",
  "private": true,
  "description": "Реплика лендинга снэпбилд + пять новых секций (тестовое задание Fullstack Developer)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gh": "NEXT_PUBLIC_BASE_PATH=/snapbuild-test-task next build",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint . && tsc --noEmit",
    "assets": "bash scripts/fetch-assets.sh && node scripts/optimize-images.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "audit": "node scripts/audit.mjs",
    "deploy": "npm run build:gh && gh-pages -d out -t -m \"deploy: static export\""
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.4",
    "gh-pages": "6.3.0",
    "sharp": "^0.34.5",
    "typescript": "5.9.2"
  }
}
